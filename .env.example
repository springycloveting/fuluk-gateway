# Session Gateway production environment example.
# Copy to /etc/session-gateway/session-gateway.env for systemd deployments.

HOST=127.0.0.1
PORT=8787

# Required in production. Use a long random value.
SESSION_GATEWAY_TOKEN=change-me

# Keep production state outside the git checkout.
SESSION_GATEWAY_DB=/var/lib/session-gateway/session-gateway.sqlite
SESSION_GATEWAY_SETTINGS=/var/lib/session-gateway/session-gateway-settings.json

# Runtime shell used by "runtime" sessions.
SESSION_GATEWAY_RUNTIME=/bin/bash

# tmux send-keys submit behavior.
SESSION_GATEWAY_CODEX_SUBMIT_KEY=Enter
SESSION_GATEWAY_CLAUDE_SUBMIT_KEY=Enter
SESSION_GATEWAY_OPENCODE_SUBMIT_KEY=Enter
SESSION_GATEWAY_RUNTIME_SUBMIT_KEY=Enter
SESSION_GATEWAY_SUBMIT_KEY_DELAY_MS=80

# Optional fallback commands when Web config has not been saved yet.
SESSION_GATEWAY_CODEX_CMD="docker exec -it worker-codex codex"
SESSION_GATEWAY_CLAUDE_CMD="docker exec -it worker-claude claude"
SESSION_GATEWAY_OPENCODE_CMD="docker exec -it worker-opencode opencode"
